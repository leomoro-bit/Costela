# Copie este arquivo para .env.local (no computador) ou cadastre na Vercel
# (Settings ▸ Environment Variables). São as ÚNICAS variáveis necessárias.
#
# Onde achar: Supabase ▸ seu projeto ▸ Project Settings ▸ API (ou botão "Connect").

# Project URL
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública "anon" (projetos antigos) OU "publishable" (sb_publishable_..., projetos novos).
# Use UMA das duas linhas abaixo.
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# NUNCA coloque a chave "service_role" / "secret" aqui: ela ignora a segurança do banco.
